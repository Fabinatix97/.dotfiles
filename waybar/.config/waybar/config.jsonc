{
    "margin": "10 15 -5 20",
    "modules-left": [
        "hyprland/workspaces",
        "custom/pacman",
        "custom/audio",
        "backlight",
        "bluetooth",
        "network",
        "custom/nordvpn"
    ],
    "modules-center": [
        "custom/day",
        "clock"
    ],
    "modules-right": [
        "custom/recording",
        "tray",
        "group/system",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "custom/power"
    ],


    //***************************
    //*  Modules configuration  *
    //***************************

    "custom/pacman": {
        "format": "{} 󰣇",
        "interval": 3600,
        "exec": "yay -Qu 2>/dev/null | wc -l",
        "exec-if": "command -v yay",
        "on-click": "kitty --class waybar sh -c 'yay -Syu --needed --noconfirm; echo Done - Press enter to exit; read'; pkill -SIGRTMIN+8 waybar",
        "signal": 8,
        "tooltip": false
    },

    "custom/audio": {
        "exec": "$HOME/.config/waybar/scripts/audio-status.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "kitty --class waybar $HOME/.config/waybar/scripts/audio-select.sh",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip": true
    },

    "bluetooth": {
        "format": "󰂯",
        "on-click": "kitty --class waybar --hold -e bluetui",
        "tooltip": false
    },

    "network": {
        "format": "",
        "format-wifi": "",
        "format-ethernet": "󰌗",
        "format-disconnected": "󰖪",
        "on-click": "kitty --class waybar -e $HOME/.local/bin/nmtui",
        "min-length": 3,
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "custom/nordvpn": {
        "format": "{} ",
        "interval": 15,
        "exec": "$HOME/.config/waybar/scripts/nordvpn_status.sh",
        "on-click": "kitty --class waybar sh -c '$HOME/.config/waybar/scripts/nordvpn_connect.sh'",
        "signal": 9,
        "tooltip": false
    },

    "custom/recording": {
        "format": "󰻃 REC",
        "interval": 1,
        "exec-if": "pgrep -x wf-recorder",
        "exec": "cat /tmp/wf-recorder-current",
        "tooltip": true
    },

    "custom/day": {
        "interval": 60,
        "return-type": "json",
        "exec": "date '+{\"text\":\"%d\",\"tooltip\":\"%A %d %B %Y\"}'"
    },

    "clock": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "tooltip": false
    },

    "memory": {
        "format": "{used:0.1f}G ",
        "interval": 3,
        "tooltip": false
    },

    "cpu": {
        "format": "{usage}% ",
        "interval": 3,
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% {icon}",
        "format-icons": ["󰃚","󰃛","󰃜","󰃝","󰃞","󰃟","󰃠"],
        "min-length": 7,
        "tooltip": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-update": "$HOME/.config/waybar/scripts/check_battery.sh"
    },

    "custom/power": {
        "format" : "⏻ ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "poweroff": "poweroff",
            "reboot": "reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
